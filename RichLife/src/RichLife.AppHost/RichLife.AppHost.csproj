<Project Sdk="Microsoft.NET.Sdk">
	<Sdk Name="Aspire.AppHost.Sdk" Version="9.5.2" />

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Aspire.Hosting.AppHost" Version="9.5.2" />
		<PackageReference Include="Aspire.Hosting.PostgreSQL" Version="9.5.2" />
		<!-- Pinned above the vulnerable 2.5.192 that Aspire.Hosting pulls in transitively. -->
		<PackageReference Include="MessagePack" Version="2.5.305" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\RichLife.Api\RichLife.Api.csproj">
			<IsAspireProjectResource>true</IsAspireProjectResource>
		</ProjectReference>
		<ProjectReference Include="..\RichLife.ServiceDefaults\RichLife.ServiceDefaults.csproj"
						  IsAspireProjectResource="false" />
	</ItemGroup>

</Project>